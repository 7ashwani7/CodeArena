# Server Port
PORT=5000

# Environment Mode: development | test | production
NODE_ENV=development

# Frontend Application URL (for CORS and cookie origin policy)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/codearena
MONGODB_URI=mongodb://127.0.0.1:27017/codearena

# JWT & Cookie secrets
JWT_SECRET=change_this_to_a_cryptographically_strong_random_string
COOKIE_SECRET=change_this_to_another_cryptographically_strong_random_string

# Judge0 Sandboxed Execution Provider
# Option A: RapidAPI Judge0
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# Option B: Self-Hosted Judge0 (Docker / local CE)
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
