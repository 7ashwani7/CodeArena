# ==========================================
# CodeArena Root Environment Configuration
# Template for local development setup
# Never commit real credentials or .env files!
# ==========================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/codearena?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_jwt_random_secret_at_least_32_characters
COOKIE_SECRET=replace_with_a_secure_cookie_random_secret

# --- Client Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api

# --- Judge0 Sandboxed Code Execution Service ---
# For RapidAPI:
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# For Self-Hosted Judge0 CE (docker / local):
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
